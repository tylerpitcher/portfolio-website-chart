<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>{{ env.Getenv "CHART_NAME" }}</title>

        <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    </head>

    <body class="bg-gray-50 text-gray-900">
        <div class="mx-auto max-w-4xl px-6 py-12">

            <!-- Header -->
            <header class="mb-10">
                <div class="flex items-center gap-3">
                    <h1 class="text-4xl font-bold tracking-tight">
                        {{ env.Getenv "CHART_NAME" }}
                    </h1>

                    <span class="rounded-full bg-blue-100 px-3 py-1 text-sm font-medium text-blue-700">
                        v{{ env.Getenv "CHART_VERSION" }}
                    </span>
                </div>

                <p class="mt-3 text-lg text-gray-600">
                    {{ env.Getenv "CHART_DESCRIPTION" }}
                </p>
            </header>

            <!-- Helm Repository -->
            <section class="mb-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold">
                    Helm Repository
                </h2>

                <p class="mt-2 text-gray-600">
                    Add the repository to your Helm installation:
                </p>

                <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-sm text-gray-100"><code>helm repo add {{ env.Getenv "CHART_NAME" }} {{ env.Getenv "HELM_REPO_URL" }}
helm repo update</code></pre>
            </section>

            <!-- Application -->
            {{ if eq (env.Getenv "CHART_TYPE") "application" }}

            <section class="mb-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold">
                    Installation
                </h2>

                <p class="mt-2 text-gray-600">
                    Install the chart using Helm:
                </p>

                <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-sm text-gray-100"><code>helm install {{ env.Getenv "CHART_NAME" }} \
    {{ env.Getenv "CHART_NAME" }}/{{ env.Getenv "CHART_NAME" }} \
    --version {{ env.Getenv "CHART_VERSION" }}</code></pre>
            </section>

            <section class="mb-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold">
                    Upgrade
                </h2>

                <p class="mt-2 text-gray-600">
                    Upgrade an existing installation:
                </p>

                <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-sm text-gray-100"><code>helm upgrade {{ env.Getenv "CHART_NAME" }} \
    {{ env.Getenv "CHART_NAME" }}/{{ env.Getenv "CHART_NAME" }} \
    --version {{ env.Getenv "CHART_VERSION" }}</code></pre>
            </section>

            {{ else }}

            <!-- Library / Dependency -->
            <section class="mb-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold">
                    Usage
                </h2>

                <p class="mt-2 text-gray-600">
                    Add the chart as a dependency:
                </p>

                <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-4 text-sm text-gray-100"><code>dependencies:
  - name: {{ env.Getenv "CHART_NAME" }}
    version: {{ env.Getenv "CHART_VERSION" }}
    repository: "{{ env.Getenv "HELM_REPO_URL" }}"</code></pre>
            </section>

            {{ end }}

            <!-- Available Versions -->
            <section class="mb-8 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
                <h2 class="text-xl font-semibold">
                    Available Versions
                </h2>

                <p class="mt-2 text-gray-600">
                    View all published versions of the chart.
                </p>

                <a
                    href="index.yaml"
                    class="mt-4 inline-block rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
                >
                    View index.yaml
                </a>
            </section>

            <!-- Links -->
            <footer class="flex gap-3">
                <a
                    href="{{ env.Getenv "SOURCE_URL" }}"
                    class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
                >
                    View on GitHub
                </a>
            </footer>

        </div>
    </body>
</html>
